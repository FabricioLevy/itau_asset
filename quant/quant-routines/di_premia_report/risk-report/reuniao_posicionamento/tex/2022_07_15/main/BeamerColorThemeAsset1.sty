% Cores, Background, entre outras coisas.
\usepackage{color}
%R G B
\DefineNamedColor{named}{blue1}{RGB}{40,130,155}
\DefineNamedColor{named}{gray1}{RGB}{50,62,72}
\DefineNamedColor{named}{gray2}{RGB}{201,203,203}
\DefineNamedColor{named}{gray3}{RGB}{116,141,158}
\DefineNamedColor{named}{blue2}{RGB}{46,154,178}
\DefineNamedColor{named}{laranja1}{RGB}{255,146,5}


\mode<presentation>
\setbeamercolor{author in head/foot}{bg=blue1, fg=white}
\setbeamercolor{title in head/foot}{bg=gray1, fg=white}
%\setbeamercolor{institute in head/foot}{fg=instituteColor}
\setbeamercolor{date in head/foot}{bg=blue1, fg=white}

\setbeamercolor{alerted text}{fg=blue1!80!laranja1}
\setbeamercolor*{palette primary}{fg=white,bg=blue1}
\setbeamercolor*{palette secondary}{fg=gray1,bg=white}
\setbeamercolor*{palette tertiary}{fg=white,bg=blue2}
\setbeamercolor*{palette quaternary}{fg=white,bg=gray2}
\setbeamercolor*{structure}{fg=blue2,bg=white}
\setbeamercolor{frametitle}{fg=white,bg=blue1}
\mode<all>

\defbeamertemplate*{footline}{Asset1 theme}
{%
	\leavevmode%
	\hbox{
		\begin{beamercolorbox}[wd=.333333\paperwidth,ht=2.25ex,dp=1ex,center]{author in head/foot}%
			\usebeamerfont{author in head/foot}\insertshortauthor%~~
			%\insertshortinstitute
		\end{beamercolorbox}%
		
		\begin{beamercolorbox}[wd=.333333\paperwidth,ht=2.25ex,dp=1ex,center]{title in head/foot}%
			\usebeamerfont{title in head/foot}\insertshorttitle
		\end{beamercolorbox}%
		
		\begin{beamercolorbox}[wd=.333333\paperwidth,ht=2.25ex,dp=1ex,right]{date in head/foot}%
			\usebeamerfont{date in head/foot}\insertshortdate{}\hspace*{2em}\insertframenumber{} / \inserttotalframenumber\hspace*{2ex}
		\end{beamercolorbox}}%
	\vskip0pt%
}

\setbeamertemplate{headline}
{%
	\begin{beamercolorbox}[colsep=1.5pt]{upper separation line head}
	\end{beamercolorbox}
	\begin{beamercolorbox}{section in head/foot}
		\vskip2pt\insertnavigation{\paperwidth}\vskip2pt
	\end{beamercolorbox}%
	\begin{beamercolorbox}[colsep=1.5pt]{lower separation line head}
	\end{beamercolorbox}
}

